<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>LuckyFlow 🌿</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #F5F0E8;
  --bg2: #EDE7D9;
  --surface: #FDFAF4;
  --surface2: #F0EBE0;
  --border: rgba(160,140,110,0.18);
  --border2: rgba(160,140,110,0.3);
  --text: #2D2A24;
  --text2: #5C5548;
  --muted: #9C8F7E;
  --muted2: #BFB4A4;
  --green: #5A8A6A;
  --green-soft: rgba(90,138,106,0.12);
  --green-mid: rgba(90,138,106,0.25);
  --green-glow: rgba(90,138,106,0.2);
  --sage: #8FAF8A;
  --sand: #C8A97E;
  --terracotta: #C17B5C;
  --terracotta-soft: rgba(193,123,92,0.12);
  --accent: #5A8A6A;
  --accent-soft: rgba(90,138,106,0.1);
  --water: #6BA3BE;
  --focus: #8B7355;
  --focus-soft: rgba(139,115,85,0.1);
  --shadow: 0 2px 16px rgba(100,80,50,0.08);
  --shadow-md: 0 4px 24px rgba(100,80,50,0.12);
  --warn: #D4845A;
  --warn-soft: rgba(212,132,90,0.1);
  --crisis: #8B6A6A;
  --crisis-soft: rgba(139,106,106,0.08);
  --crisis-border: rgba(139,106,106,0.2);
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; overflow-x:hidden; }
body::before {
  content:''; position:fixed; inset:0; pointer-events:none; z-index:0;
  background:
    radial-gradient(ellipse 60% 40% at 0% 0%, rgba(90,138,106,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 50% 35% at 100% 100%, rgba(193,123,92,0.07) 0%, transparent 60%);
}
.app { max-width:460px; margin:0 auto; padding:20px 16px 80px; position:relative; z-index:1; }

/* HEADER */
.header { text-align:center; padding:34px 0 24px; }
.logo { font-family:'Playfair Display',serif; font-size:48px; letter-spacing:-1px; color:var(--text); line-height:1; }
.logo em { color:var(--green); font-style:italic; }
.logo-leaf { display:inline-block; animation:sway 4s ease-in-out infinite; transform-origin:bottom center; }
.logo-sub { font-size:11px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:var(--muted); margin-top:7px; }
#date-display { font-size:12px; font-weight:500; color:var(--muted2); margin-top:5px; letter-spacing:0.3px; }
@keyframes sway { 0%,100%{transform:rotate(-3deg)} 50%{transform:rotate(3deg)} }

/* CARD */
.card { background:var(--surface); border:1px solid var(--border); border-radius:22px; padding:22px; margin-bottom:14px; box-shadow:var(--shadow); }
.card-title { font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--muted); margin-bottom:18px; display:flex; align-items:center; gap:7px; }

/* SECTION DIVIDER */
.section-divider { display:flex; align-items:center; gap:12px; margin:22px 0 14px; }
.section-divider-line { flex:1; height:1px; background:var(--border2); }
.section-divider-text { font-family:'Playfair Display',serif; font-size:13px; font-style:italic; color:var(--muted); white-space:nowrap; }

/* MOOD */
.mood-options { display:flex; gap:8px; margin-bottom:4px; }
.mood-opt {
  flex:1; display:flex; flex-direction:column; align-items:center; gap:5px;
  padding:13px 6px; border-radius:16px; border:1.5px solid var(--border);
  background:var(--bg2); cursor:pointer; transition:all 0.2s;
}
.mood-opt:hover { background:var(--surface2); transform:translateY(-2px); }
.mood-opt .mood-emoji { font-size:26px; line-height:1; }
.mood-opt .mood-word { font-size:9px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; color:var(--muted); text-align:center; }
.mood-opt.selected { background:var(--accent-soft); border-color:rgba(90,138,106,0.45); transform:translateY(-3px); box-shadow:0 4px 14px var(--green-glow); }
.mood-opt.selected .mood-word { color:var(--accent); }

.mood-suggestion { margin-top:14px; padding:16px; border-radius:16px; border:1.5px solid; display:none; animation:fadeSlide 0.4s ease both; }
.mood-suggestion.show { display:block; }
.mood-suggestion.level-tips { background:var(--warn-soft); border-color:rgba(212,132,90,0.25); }
.mood-suggestion.level-crisis { background:var(--crisis-soft); border-color:var(--crisis-border); }
.suggestion-title { font-size:11px; font-weight:800; letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; }
.suggestion-title.warn { color:var(--warn); }
.suggestion-title.crisis { color:var(--crisis); }
.suggestion-items { display:flex; flex-direction:column; gap:8px; }
.suggestion-item { display:flex; align-items:flex-start; gap:10px; font-size:13px; font-weight:500; color:var(--text2); line-height:1.5; }
.suggestion-item-icon { font-size:18px; flex-shrink:0; margin-top:1px; }
.crisis-text { font-size:13px; color:var(--text2); line-height:1.7; }
.crisis-text strong { color:var(--crisis); }

@keyframes fadeSlide { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }

.mood-history { margin-top:16px; padding-top:14px; border-top:1px solid var(--border); }
.mood-history-title { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:10px; }
.mood-hist-row { display:flex; gap:6px; }
.mood-hist-item { width:32px; height:32px; border-radius:9px; background:var(--bg2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:16px; }
.mood-hist-item.bad { background:rgba(212,132,90,0.1); border-color:rgba(212,132,90,0.2); }
.mood-hist-item.verybad { background:rgba(139,106,106,0.08); border-color:rgba(139,106,106,0.15); }

/* ENERGY */
.energy-options { display:flex; gap:8px; margin-bottom:14px; }
.energy-opt { flex:1; display:flex; flex-direction:column; align-items:center; gap:5px; padding:12px 4px; border-radius:16px; border:1.5px solid var(--border); background:var(--bg2); cursor:pointer; transition:all 0.2s; }
.energy-opt:hover { background:var(--surface2); transform:translateY(-2px); }
.energy-opt .e-icon { font-size:22px; }
.energy-opt .e-label { font-size:9px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; color:var(--muted); text-align:center; }
.energy-opt.selected { background:var(--accent-soft); border-color:rgba(90,138,106,0.45); transform:translateY(-3px); box-shadow:0 4px 12px var(--green-glow); }
.energy-opt.selected .e-label { color:var(--accent); }

.energy-rec { padding:16px; border-radius:16px; border:1.5px solid var(--green-mid); background:var(--green-soft); display:none; animation:fadeSlide 0.4s ease both; }
.energy-rec.show { display:block; }
.energy-rec-title { font-size:10px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:var(--green); margin-bottom:10px; }
.energy-rec-items { display:flex; flex-direction:column; gap:8px; }
.energy-rec-item { display:flex; align-items:flex-start; gap:10px; font-size:13px; color:var(--text2); line-height:1.5; }
.energy-rec-icon { font-size:18px; flex-shrink:0; }

/* FOCUS TIMER */
.timer-card { background:linear-gradient(135deg, #FDFAF4, #F5EDD8); border-color:rgba(139,115,85,0.2); }
.timer-ring-wrap { position:relative; width:156px; height:156px; margin:0 auto 18px; }
.timer-svg { width:156px; height:156px; transform:rotate(-90deg); }
.timer-track { fill:none; stroke:rgba(139,115,85,0.1); stroke-width:7; }
.timer-progress { fill:none; stroke:var(--focus); stroke-width:7; stroke-linecap:round; stroke-dasharray:428; stroke-dashoffset:428; transition:stroke-dashoffset 1s linear; }
.timer-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.timer-time { font-family:'Playfair Display',serif; font-size:40px; color:var(--focus); line-height:1; letter-spacing:-1px; }
.timer-lbl { font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-top:4px; }
.timer-input-lbl { font-size:10px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:6px; text-align:center; }
.timer-input { width:100%; background:var(--bg2); border:1px solid rgba(139,115,85,0.2); border-radius:12px; padding:10px 12px; font-size:24px; font-family:'Playfair Display',serif; color:var(--focus); text-align:center; outline:none; transition:border-color 0.2s; margin-bottom:14px; }
.timer-input:focus { border-color:rgba(139,115,85,0.45); }
.timer-btns { display:flex; gap:8px; }
.btn-t { flex:1; padding:13px; border:none; border-radius:13px; font-family:'DM Sans',sans-serif; font-size:13px; font-weight:700; cursor:pointer; transition:all 0.2s; }
.btn-start { background:var(--focus); color:#FDFAF4; box-shadow:0 4px 16px rgba(139,115,85,0.25); }
.btn-start:hover { transform:translateY(-1px); box-shadow:0 6px 22px rgba(139,115,85,0.35); }
.btn-reset { background:var(--surface2); color:var(--text2); border:1px solid var(--border2); }
.btn-reset:hover { background:var(--bg2); }
.focus-sessions-wrap { margin-top:16px; }
.focus-sessions-lbl { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--muted); margin-bottom:8px; }
.focus-sessions { display:flex; flex-wrap:wrap; gap:6px; }
.focus-pill { font-size:11px; font-weight:600; padding:4px 12px; border-radius:50px; background:var(--focus-soft); border:1px solid rgba(139,115,85,0.2); color:var(--focus); }

/* WATER */
.water-glasses { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px; }
.water-glass { width:30px; height:38px; border-radius:3px 3px 8px 8px; border:1.5px solid rgba(107,163,190,0.3); background:rgba(107,163,190,0.05); cursor:pointer; transition:all 0.2s; position:relative; overflow:hidden; }
.water-glass::before { content:''; position:absolute; bottom:0; left:0; right:0; height:0%; background:linear-gradient(180deg, rgba(107,163,190,0.55), rgba(59,120,155,0.8)); transition:height 0.3s ease; border-radius:0 0 6px 6px; }
.water-glass.filled::before { height:100%; }
.water-glass.filled { border-color:rgba(107,163,190,0.6); box-shadow:0 0 6px rgba(107,163,190,0.15); }
.water-glass:hover { transform:translateY(-2px); }
.water-count { font-size:13px; font-weight:600; color:var(--water); }

/* SLEEP */
.sleep-row { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.sleep-hrs { font-family:'Playfair Display',serif; font-size:42px; line-height:1; color:var(--text); }
.sleep-hrs.good { color:var(--green); }
.sleep-hrs.ok { color:var(--sand); }
.sleep-hrs.bad { color:var(--terracotta); }
.sleep-unit { font-size:14px; color:var(--muted); padding-top:8px; }
.sleep-stepper { display:flex; flex-direction:column; gap:5px; }
.sleep-btn { width:30px; height:30px; border-radius:9px; border:1px solid var(--border2); background:var(--surface2); color:var(--text2); font-size:16px; font-weight:700; cursor:pointer; transition:all 0.15s; display:flex; align-items:center; justify-content:center; }
.sleep-btn:hover { background:var(--bg2); }
.sleep-btn:active { transform:scale(0.9); }
.sleep-note { font-size:12px; color:var(--muted); font-style:italic; margin-bottom:10px; }
.sleep-bar-bg { height:6px; background:var(--bg2); border-radius:50px; overflow:hidden; }
.sleep-bar { height:100%; border-radius:50px; transition:width 0.5s ease; background:linear-gradient(90deg, var(--sage), var(--green)); }

/* NOTES */
.notes-area { width:100%; background:var(--bg2); border:1px solid var(--border); border-radius:14px; padding:14px 16px; font-size:14px; font-family:'DM Sans',sans-serif; color:var(--text); outline:none; resize:none; min-height:90px; line-height:1.7; transition:border-color 0.2s; }
.notes-area:focus { border-color:var(--border2); }
.notes-area::placeholder { color:var(--muted2); font-style:italic; }
.notes-save { margin-top:10px; width:100%; padding:12px; border:none; border-radius:13px; font-family:'DM Sans',sans-serif; font-size:12px; font-weight:700; cursor:pointer; background:var(--green-soft); color:var(--green); border:1px solid var(--green-mid); transition:all 0.2s; letter-spacing:1.5px; text-transform:uppercase; }
.notes-save:hover { background:var(--green-mid); }

/* SUMMARY */
.summary-row { display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid var(--border); }
.summary-row:last-child { border-bottom:none; }
.summary-label { font-size:13px; color:var(--text2); font-weight:500; }
.summary-val { font-size:14px; font-weight:700; color:var(--green); }

/* MGMT */
.mgmt-btns { display:flex; flex-direction:column; gap:8px; }
.mgmt-btn { width:100%; padding:12px 16px; border-radius:13px; font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s; text-align:left; display:flex; align-items:center; gap:10px; background:var(--surface2); color:var(--text2); border:1px solid var(--border); }
.mgmt-btn:hover { background:var(--bg2); transform:translateX(2px); }
.mgmt-btn.danger { color:var(--terracotta); background:var(--terracotta-soft); border-color:rgba(193,123,92,0.2); }
.mgmt-btn.danger:hover { background:rgba(193,123,92,0.18); }

/* MODAL */
.modal-bg { display:none; position:fixed; inset:0; background:rgba(45,42,36,0.45); backdrop-filter:blur(6px); z-index:100; align-items:center; justify-content:center; padding:24px; }
.modal-bg.show { display:flex; }
.modal { background:var(--surface); border:1px solid var(--border2); border-radius:24px; padding:30px 24px; text-align:center; max-width:320px; width:100%; box-shadow:var(--shadow-md); animation:popIn 0.25s cubic-bezier(0.22,1,0.36,1) both; }
.modal-icon { font-size:40px; margin-bottom:12px; }
.modal-title { font-family:'Playfair Display',serif; font-size:26px; color:var(--terracotta); margin-bottom:8px; }
.modal-desc { font-size:13px; color:var(--text2); line-height:1.6; margin-bottom:22px; }
.modal-actions { display:flex; gap:10px; }
.modal-cancel { flex:1; padding:12px; border-radius:12px; border:1px solid var(--border2); background:var(--surface2); color:var(--text2); font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; cursor:pointer; }
.modal-cancel:hover { background:var(--bg2); }
.modal-confirm { flex:1; padding:12px; border-radius:12px; border:none; background:var(--terracotta); color:white; font-family:'DM Sans',sans-serif; font-size:13px; font-weight:700; cursor:pointer; box-shadow:0 4px 16px rgba(193,123,92,0.3); }
.modal-confirm:hover { transform:translateY(-1px); }

/* TOAST */
.toast { position:fixed; bottom:28px; left:50%; transform:translateX(-50%) translateY(70px); background:var(--text); color:var(--bg); padding:11px 22px; border-radius:50px; font-size:13px; font-weight:600; z-index:200; transition:transform 0.3s cubic-bezier(0.22,1,0.36,1); white-space:nowrap; pointer-events:none; }
.toast.show { transform:translateX(-50%) translateY(0); }

@keyframes popIn { from{opacity:0;transform:scale(0.93) translateY(8px)} to{opacity:1;transform:scale(1) translateY(0)} }
@keyframes timerPulse { 0%,100%{opacity:1} 50%{opacity:0.5} }
.timer-running .timer-time { animation:timerPulse 1.8s ease infinite; }
@media(max-width:380px) { .logo{font-size:40px;} .mood-opt{padding:10px 4px;} .mood-opt .mood-emoji{font-size:22px;} }
</style>
</head>
<body>
<div class="app">

  <div class="header">
    <div class="logo"><em>Lucky</em>Flow <span class="logo-leaf">🌿</span></div>
    <div class="logo-sub">Tvůj den, tvá energie</div>
    <div id="date-display">---</div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Nálada</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">✨ <span>Jak se dnes cítíš?</span></div>
    <div class="mood-options" id="mood-opts"></div>
    <div class="mood-suggestion" id="mood-suggestion"></div>
    <div class="mood-history">
      <div class="mood-history-title">Posledních 7 dní</div>
      <div class="mood-hist-row" id="mood-hist"></div>
    </div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Energie</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">⚡ <span>Jak na tom jsi s energií?</span></div>
    <div class="energy-options" id="energy-opts"></div>
    <div class="energy-rec" id="energy-rec"></div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Soustředění</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card timer-card" id="timer-card">
    <div class="card-title">⏱ <span>Focus timer</span></div>
    <div style="text-align:center">
      <div class="timer-ring-wrap">
        <svg class="timer-svg" viewBox="0 0 156 156">
          <circle class="timer-track" cx="78" cy="78" r="68"/>
          <circle class="timer-progress" id="timer-ring" cx="78" cy="78" r="68"/>
        </svg>
        <div class="timer-center">
          <div class="timer-time" id="timer-time">25:00</div>
          <div class="timer-lbl" id="timer-lbl">připraveno</div>
        </div>
      </div>
      <div class="timer-input-lbl">Počet minut</div>
      <input id="timer-mins" class="timer-input" type="number" min="1" max="180" value="25">
      <div class="timer-btns">
        <button class="btn-t btn-start" id="timer-start-btn" onclick="toggleTimer()">▶ Spustit</button>
        <button class="btn-t btn-reset" onclick="resetTimer()">↺ Reset</button>
      </div>
    </div>
    <div class="focus-sessions-wrap">
      <div class="focus-sessions-lbl">Dnešní sessions</div>
      <div class="focus-sessions" id="focus-sessions">
        <span style="font-size:12px;color:var(--muted2);font-style:italic">Zatím nic…</span>
      </div>
    </div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Hydratace</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">💧 <span>Denní pitný režim · 8 sklenic</span></div>
    <div class="water-glasses" id="water-glasses"></div>
    <div class="water-count" id="water-count">0 / 8 sklenic</div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Spánek</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">🌙 <span>Kolik jsi spala?</span></div>
    <div class="sleep-row">
      <div class="sleep-hrs" id="sleep-val">7</div>
      <div class="sleep-unit">h</div>
      <div class="sleep-stepper">
        <button class="sleep-btn" onclick="changeSleep(0.5)">+</button>
        <button class="sleep-btn" onclick="changeSleep(-0.5)">−</button>
      </div>
    </div>
    <div class="sleep-note" id="sleep-note"></div>
    <div class="sleep-bar-bg"><div class="sleep-bar" id="sleep-bar" style="width:70%"></div></div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Zápisek</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">📝 <span>Dnešní zápisek</span></div>
    <textarea id="notes-area" class="notes-area" placeholder="Co dnes bylo dobré? Na co jsi pyšná? Co chceš zítra jinak?"></textarea>
    <button class="notes-save" onclick="saveNotes()">Uložit</button>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Přehled dne</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="card-title">🌸 <span>Dnešní souhrn</span></div>
    <div class="summary-row">
      <div class="summary-label">💧 Voda</div>
      <div class="summary-val" id="sum-water">0/8</div>
    </div>
    <div class="summary-row">
      <div class="summary-label">🌙 Spánek</div>
      <div class="summary-val" id="sum-sleep">7h</div>
    </div>
    <div class="summary-row">
      <div class="summary-label">✨ Nálada</div>
      <div class="summary-val" id="sum-mood">–</div>
    </div>
    <div class="summary-row">
      <div class="summary-label">⏱ Focus celkem</div>
      <div class="summary-val" id="sum-focus">0 min</div>
    </div>
  </div>

  <div class="section-divider">
    <div class="section-divider-line"></div>
    <div class="section-divider-text">Nastavení</div>
    <div class="section-divider-line"></div>
  </div>

  <div class="card">
    <div class="mgmt-btns">
      <button class="mgmt-btn" id="sync-btn" onclick="syncData(true)">🔄 Synchronizovat</button>
      <button class="mgmt-btn danger" onclick="showReset()">🍂 Reset dnešních dat</button>
    </div>
  </div>

</div>

<div id="modal" class="modal-bg">
  <div class="modal">
    <div class="modal-icon">🍂</div>
    <div class="modal-title">Reset dne?</div>
    <div class="modal-desc">Smaže dnešní data — vodu, náladu, energii, spánek a focus. Historie nálad zůstane.</div>
    <div class="modal-actions">
      <button class="modal-cancel" onclick="hideReset()">Zpět</button>
      <button class="modal-confirm" onclick="confirmReset()">Resetovat</button>
    </div>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
const BIN_ID = 'ff0047872f7244259758'; // 
const API_URL = `https://api.npoint.io/${BIN_ID}`;

const MOODS = [
  { emoji:'😄', label:'Skvěle',  score:5 },
  { emoji:'🙂', label:'Dobře',   score:4 },
  { emoji:'😐', label:'Ujde',    score:3 },
  { emoji:'😔', label:'Špatně',  score:2 },
  { emoji:'😢', label:'Těžce',   score:1 },
];

const BAD_THRESHOLD = 2;
const CRISIS_DAYS   = 4;

const ENERGY_LEVELS = [
  { emoji:'⚡', label:'Nabitá',  level:4 },
  { emoji:'🌤', label:'Dobře',   level:3 },
  { emoji:'😌', label:'Klidně',  level:2 },
  { emoji:'🍃', label:'Pomalu',  level:1 },
  { emoji:'🪫',  label:'Vybitá',  level:0 },
];

const ENERGY_RECS = {
  4: [
    { icon:'🏃‍♀️', text:'Jdi si zaběhat nebo na kolo – využij tu energii naplno!' },
    { icon:'🧗',   text:'Vyraz do přírody, třeba na delší túru nebo do parku.' },
    { icon:'🎨',   text:'Pusť se do kreativního projektu, který jsi odkládala.' },
  ],
  3: [
    { icon:'🚶‍♀️', text:'Procházka venku ti udělá dobře a udrží energii.' },
    { icon:'📚',   text:'Ideální čas na čtení nebo jemnou kreativu.' },
    { icon:'🧘',   text:'Jóga nebo lehký strečink pro udržení pohody.' },
  ],
  2: [
    { icon:'🌿', text:'Kratší procházka na čerstvém vzduchu osvěží mysl.' },
    { icon:'☕',  text:'Udělej si rituál – čaj, pohodlné místo, oblíbená knížka.' },
    { icon:'🎵', text:'Pusť si hudbu, která tě nabije, a dej si krátký odpočinek.' },
  ],
  1: [
    { icon:'🛋️', text:'Dovol si odpočinout – lehký den je taky v pořádku.' },
    { icon:'📖',  text:'Přečti si pár stránek knížky, nic víc se od tebe nechce.' },
    { icon:'🌸',  text:'Vyjdi ven jen na chvíli – i 10 minut přírody pomůže.' },
  ],
  0: [
    { icon:'🛁',  text:'Priorita č. 1: odpočinek. Koupel, přikrývka, klid.' },
    { icon:'🍵',  text:'Něco teplého k pití a nic víc – dnes si zasloužíš pauzu.' },
    { icon:'🤗',  text:'Pomazlit mazlíčka nebo zavolat blízkému může udělat divy.' },
  ],
};

const MOOD_TIPS = [
  { icon:'🌳', text:'Vyjdi ven – i krátká procházka mění perspektivu.' },
  { icon:'🐾', text:'Pomazli mazlíčka, pokud ho máš. Funguje to vždy.' },
  { icon:'📖', text:'Otevři knížku a dej si 20 minut jen pro sebe.' },
  { icon:'☕', text:'Udělej si oblíbený nápoj a sedni si na klidné místo.' },
  { icon:'🎵', text:'Pusť si písničku, která tě vždycky rozveselí.' },
  { icon:'🧁', text:'Připrav si něco dobrého k jídlu – vaření uklidňuje.' },
  { icon:'💌', text:'Napiš zprávu kamarádce, které důvěřuješ.' },
];

const DEFAULT_STATE = () => ({
  today: new Date().toDateString(),
  water: 0, sleep: 7, mood: null, energy: null,
  moodHistory: [], history: [],
  focusSessions: [], notes: '', lastUpdated: 0,
});

let state = DEFAULT_STATE();
let isSaving = false;
let timerInterval = null, timerTotal = 0, timerRemaining = 0, timerRunning = false;

function renderDate() {
  const dny = ['Neděle','Pondělí','Úterý','Středa','Čtvrtek','Pátek','Sobota'];
  const d = new Date();
  document.getElementById('date-display').textContent =
    `${dny[d.getDay()]}, ${d.getDate()}. ${d.getMonth()+1}. ${d.getFullYear()}`;
}

function checkNewDay() {
  const today = new Date().toDateString();
  if (state.today !== today) {
    const entry = {
      date: state.today, mood: state.mood, energy: state.energy,
      water: state.water, sleep: state.sleep,
      focusTotal: (state.focusSessions||[]).reduce((a,b)=>a+b,0),
      notes: state.notes,
    };
    if (!state.history) state.history = [];
    state.history.unshift(entry);
    if (state.history.length > 90) state.history = state.history.slice(0,90);

    if (state.mood !== null) {
      state.moodHistory.unshift({ mood: state.mood, date: state.today });
      if (state.moodHistory.length > 14) state.moodHistory = state.moodHistory.slice(0,14);
    }

    state.water = 0; state.sleep = 7; state.mood = null;
    state.energy = null; state.focusSessions = []; state.notes = '';
    state.today = today;
    save();
  }
}

function getMoodScore(emoji) {
  if (!emoji) return null;
  const m = MOODS.find(x => x.emoji === emoji);
  return m ? m.score : null;
}

function countBadStreak() {
  const allScores = [];
  const todayScore = getMoodScore(state.mood);
  if (todayScore !== null) allScores.push(todayScore);
  (state.moodHistory||[]).forEach(h => {
    const s = getMoodScore(h.mood);
    if (s !== null) allScores.push(s);
  });
  let streak = 0;
  for (let s of allScores) {
    if (s <= BAD_THRESHOLD) streak++;
    else break;
  }
  return streak;
}

function renderMoodSuggestion() {
  const el = document.getElementById('mood-suggestion');
  const score = getMoodScore(state.mood);
  if (score === null || score > BAD_THRESHOLD) {
    el.className = 'mood-suggestion'; el.innerHTML = ''; return;
  }
  const streak = countBadStreak();
  if (streak >= CRISIS_DAYS) {
    el.className = 'mood-suggestion level-crisis show';
    el.innerHTML = `
      <div class="suggestion-title crisis">🌱 Není ostuda říct si o pomoc</div>
      <div class="crisis-text">
        Všimla jsem si, že se ti delší dobu nedaří, a to je naprosto v pořádku —
        každý prochází těžšími obdobími. <strong>Není žádná ostuda mluvit o tom, jak se cítíš</strong>,
        ať už s kamarádkou, rodinou nebo odborníkem.
      </div>
      <div class="crisis-text" style="margin-top:8px">
        Promluvit si s někým může být první malý krok, který hodně změní. Nejsi v tom sama. 💛
      </div>
      <div class="crisis-text" style="margin-top:10px;font-style:italic;opacity:0.75">
        Záleží jen na tobě, s kým se rozhodneš promluvit. 🌱
      </div>
    `;
  } else {
    const tips = [...MOOD_TIPS].sort(() => Math.random() - 0.5).slice(0, 3);
    el.className = 'mood-suggestion level-tips show';
    el.innerHTML = `
      <div class="suggestion-title warn">🌻 Pár nápadů, jak si pomoct</div>
      <div class="suggestion-items">
        ${tips.map(t => `
          <div class="suggestion-item">
            <span class="suggestion-item-icon">${t.icon}</span>
            <span>${t.text}</span>
          </div>
        `).join('')}
      </div>
    `;
  }
}

function renderEnergyRec() {
  const el = document.getElementById('energy-rec');
  const level = state.energy;
  if (level === null || level === undefined) {
    el.className = 'energy-rec'; el.innerHTML = ''; return;
  }
  const recs = [...(ENERGY_RECS[level]||[])].sort(() => Math.random()-0.5).slice(0,3);
  const labels = { 4:'Nabitá energií', 3:'Dobrá energie', 2:'Klidná energie', 1:'Nízká energie', 0:'Vybitá' };
  el.className = 'energy-rec show';
  el.innerHTML = `
    <div class="energy-rec-title">✨ Doporučení pro tebe · ${labels[level]}</div>
    <div class="energy-rec-items">
      ${recs.map(r => `
        <div class="energy-rec-item">
          <span class="energy-rec-icon">${r.icon}</span>
          <span>${r.text}</span>
        </div>
      `).join('')}
    </div>
  `;
}

async function syncData(manual=false) {
  if (isSaving) return;
  const btn = document.getElementById('sync-btn');
  if (manual && btn) btn.textContent = '⏳ Načítám...';
  try {
    const res = await fetch(`${API_URL}?t=${Date.now()}`);
    if (res.ok) {
      const data = await res.json();
      if (data && 'water' in data) {
        if ((data.lastUpdated||0) >= (state.lastUpdated||0)) {
          state = { ...DEFAULT_STATE(), ...data };
          checkNewDay(); render();
        }
      }
    }
  } catch(e) { console.error('Sync error',e); }
  if (manual && btn) btn.textContent = '🔄 Synchronizovat';
}

async function save() {
  state.lastUpdated = Date.now();
  try { localStorage.setItem('luckyflow_state', JSON.stringify(state)); } catch(e){}
  render(); isSaving = true;
  try {
    await fetch(API_URL, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(state) });
  } catch(e) { console.error('Save error',e); }
  isSaving = false;
}

function loadFromLocalStorage() {
  try {
    const raw = localStorage.getItem('luckyflow_state');
    if (raw) {
      const local = JSON.parse(raw);
      if ((local.lastUpdated||0) > (state.lastUpdated||0)) {
        state = { ...DEFAULT_STATE(), ...local };
      }
    }
  } catch(e) {}
}

function render() {
  renderDate();

  // mood
  const moodWrap = document.getElementById('mood-opts');
  moodWrap.innerHTML = '';
  MOODS.forEach(m => {
    const btn = document.createElement('div');
    btn.className = 'mood-opt' + (state.mood === m.emoji ? ' selected' : '');
    btn.innerHTML = `<span class="mood-emoji">${m.emoji}</span><span class="mood-word">${m.label}</span>`;
    btn.onclick = () => setMood(m.emoji);
    moodWrap.appendChild(btn);
  });
  document.getElementById('sum-mood').textContent = state.mood || '–';
  renderMoodSuggestion();

  // mood history
  const histWrap = document.getElementById('mood-hist');
  histWrap.innerHTML = '';
  const todayEntry = state.mood ? [{ mood: state.mood }] : [];
  const allHist = [...todayEntry, ...(state.moodHistory||[])].slice(0,7);
  if (allHist.length === 0) {
    histWrap.innerHTML = '<span style="font-size:12px;color:var(--muted2);font-style:italic">Zatím žádná historie</span>';
  } else {
    allHist.forEach(h => {
      const score = getMoodScore(h.mood);
      const cls = score <= 1 ? 'mood-hist-item verybad' : score <= 2 ? 'mood-hist-item bad' : 'mood-hist-item';
      const dot = document.createElement('div');
      dot.className = cls; dot.textContent = h.mood;
      histWrap.appendChild(dot);
    });
  }

  // energy
  const energyWrap = document.getElementById('energy-opts');
  energyWrap.innerHTML = '';
  ENERGY_LEVELS.forEach(e => {
    const opt = document.createElement('div');
    opt.className = 'energy-opt' + (state.energy === e.level ? ' selected' : '');
    opt.innerHTML = `<span class="e-icon">${e.emoji}</span><span class="e-label">${e.label}</span>`;
    opt.onclick = () => setEnergy(e.level);
    energyWrap.appendChild(opt);
  });
  renderEnergyRec();

  // water
  const waterWrap = document.getElementById('water-glasses');
  waterWrap.innerHTML = '';
  for (let i=0; i<8; i++) {
    const g = document.createElement('div');
    g.className = 'water-glass' + (i < state.water ? ' filled' : '');
    g.onclick = () => toggleWater(i);
    waterWrap.appendChild(g);
  }
  document.getElementById('water-count').textContent = `${state.water} / 8 sklenic`;
  document.getElementById('sum-water').textContent = `${state.water}/8`;

  // sleep
  const h = state.sleep;
  const sleepEl = document.getElementById('sleep-val');
  sleepEl.textContent = h;
  sleepEl.className = 'sleep-hrs' + (h >= 7.5 ? ' good' : h >= 5.5 ? ' ok' : ' bad');
  document.getElementById('sleep-note').textContent =
    h >= 8   ? '🌿 Výborně! Tělo i mysl jsou odpočinuté.' :
    h >= 7   ? '😊 Dobrý spánek, tělo poděkovalo.' :
    h >= 5.5 ? '😐 Ujde, ale víc spánku by prospělo.' :
               '😞 Tělo dostalo málo. Zkus dnes jít dřív.';
  document.getElementById('sleep-bar').style.width = Math.min((h/10)*100,100) + '%';
  document.getElementById('sum-sleep').textContent = `${h}h`;

  // focus
  const sessions = state.focusSessions || [];
  const totalFocus = sessions.reduce((s,x) => s+x, 0);
  const sessWrap = document.getElementById('focus-sessions');
  sessWrap.innerHTML = sessions.length === 0
    ? '<span style="font-size:12px;color:var(--muted2);font-style:italic">Zatím nic…</span>'
    : sessions.map(s => `<div class="focus-pill">⏱ ${s} min</div>`).join('');
  document.getElementById('sum-focus').textContent = totalFocus > 0 ? `${totalFocus} min` : '0 min';

  // notes
  document.getElementById('notes-area').value = state.notes || '';
}

function setMood(emoji) {
  state.mood = state.mood === emoji ? null : emoji;
  save();
}

function setEnergy(level) {
  state.energy = state.energy === level ? null : level;
  save();
}

function toggleWater(idx) {
  state.water = (idx < state.water) ? idx : idx + 1;
  if (state.water === 8) showToast('💧 8 sklenic splněno! Skvělá práce 🌿');
  save();
}

function changeSleep(delta) {
  state.sleep = Math.max(0, Math.min(12, +(state.sleep + delta).toFixed(1)));
  save();
}

function saveNotes() {
  state.notes = document.getElementById('notes-area').value;
  showToast('📝 Zápisek uložen ✓');
  save();
}

function toggleTimer() { timerRunning ? pauseTimer() : startTimer(); }

function startTimer() {
  if (!timerRunning && timerRemaining === 0) {
    const mins = parseInt(document.getElementById('timer-mins').value) || 25;
    timerTotal = mins * 60; timerRemaining = timerTotal;
  }
  timerRunning = true;
  document.getElementById('timer-start-btn').textContent = '⏸ Pauza';
  document.getElementById('timer-card').classList.add('timer-running');
  document.getElementById('timer-lbl').textContent = 'soustředím se…';
  timerInterval = setInterval(() => {
    timerRemaining--;
    updateTimerDisplay();
    if (timerRemaining <= 0) finishTimer();
  }, 1000);
}

function pauseTimer() {
  clearInterval(timerInterval); timerRunning = false;
  document.getElementById('timer-start-btn').textContent = '▶ Pokračovat';
  document.getElementById('timer-card').classList.remove('timer-running');
  document.getElementById('timer-lbl').textContent = 'pauza';
}

function resetTimer() {
  clearInterval(timerInterval);
  timerRunning = false; timerRemaining = 0; timerTotal = 0;
  const v = document.getElementById('timer-mins').value || 25;
  document.getElementById('timer-start-btn').textContent = '▶ Spustit';
  document.getElementById('timer-time').textContent = `${String(v).padStart(2,'0')}:00`;
  document.getElementById('timer-lbl').textContent = 'připraveno';
  document.getElementById('timer-ring').style.strokeDashoffset = '428';
  document.getElementById('timer-card').classList.remove('timer-running');
}

function finishTimer() {
  clearInterval(timerInterval); timerRunning = false;
  const mins = Math.round(timerTotal / 60);
  state.focusSessions = state.focusSessions || [];
  state.focusSessions.push(mins);
  document.getElementById('timer-start-btn').textContent = '▶ Spustit';
  document.getElementById('timer-lbl').textContent = 'hotovo! 🌿';
  document.getElementById('timer-card').classList.remove('timer-running');
  timerRemaining = 0; timerTotal = 0;
  showToast(`🌿 ${mins} min focus dokončeno!`);
  save();
}

function updateTimerDisplay() {
  const m = Math.floor(timerRemaining/60), s = timerRemaining%60;
  document.getElementById('timer-time').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  document.getElementById('timer-ring').style.strokeDashoffset = 428 * (timerTotal > 0 ? timerRemaining/timerTotal : 1);
}

document.getElementById('timer-mins').addEventListener('input', function() {
  if (!timerRunning && timerRemaining === 0) {
    const v = parseInt(this.value) || 25;
    document.getElementById('timer-time').textContent = `${String(v).padStart(2,'0')}:00`;
  }
});

function showReset() { document.getElementById('modal').classList.add('show'); }
function hideReset() { document.getElementById('modal').classList.remove('show'); }
function confirmReset() {
  state.water = 0; state.sleep = 7; state.mood = null;
  state.energy = null; state.focusSessions = []; state.notes = '';
  hideReset();
  showToast('🍂 Dnešní data resetována');
  save();
}
document.getElementById('modal').addEventListener('click', e => { if(e.target===e.currentTarget) hideReset(); });

let toastT;
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(() => t.classList.remove('show'), 3000);
}

// BOOT
renderDate();
loadFromLocalStorage();
checkNewDay();
render();
syncData();
setInterval(() => syncData(false), 30000);
</script>
</body>
</html>
